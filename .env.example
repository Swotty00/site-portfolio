# Copy to `.env` and fill in. Used by docker-compose.yml (and by the backend when run locally).
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required in production (the API refuses to start with the defaults) -------------------
SECRET_KEY=
ADMIN_PASSWORD=

# --- Production domain (only for `docker compose --profile prod`, see docs/DEPLOY.md) ------------
# DOMAIN=example.com

# --- AI translation in the admin (optional) ---------------------------------------------------------
# Create a key at https://console.anthropic.com (API billing is separate from a Claude.ai plan).
# Leave empty to keep the "Translate" button off; "Copy without translating" always works.
ANTHROPIC_API_KEY=
# TRANSLATION_MODEL=claude-opus-5-5     # e.g. claude-haiku-5-5 for cheaper/faster

# --- Analytics (optional) ---------------------------------------------------------------------------------
# ANALYTICS_TIMEZONE=America/Sao_Paulo  # day boundaries in the charts (default UTC)

# --- Optional -------------------------------------------------------------------------------
ADMIN_USERNAME=admin
# Public origin(s) of the site, comma separated. Same-origin deployments behind nginx don't need CORS.
# In production:  CORS_ORIGINS=https://example.com
CORS_ORIGINS=http://localhost:8080
# Hostnames the API answers to (Host header check). Add your real domain.
# In production use your domain:  ALLOWED_HOSTS=example.com,www.example.com   (loopback is always allowed)
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Refresh-token cookie is Secure by default in production (needs HTTPS; http://localhost also works
# in most browsers). Set to false ONLY for plain-HTTP testing on a non-localhost address.
COOKIE_SECURE=true
# Fill an empty database with fictional demo projects and profile on first start.
SEED_DEMO_DATA=true
# Host port for the nginx container.
PORT=8080

# --- Backend tuning (see backend/app/core/config.py for every option) -------------------------
# ENVIRONMENT=development            # development | test | production
# DATABASE_URL=sqlite:///./data/portfolio.db
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# RATE_LIMIT_LOGIN=5                 # login attempts per minute per IP
# MAX_UPLOAD_MB=5
