# Public HTTPS entry point (used by `docker compose --profile prod`).
# Caddy obtains and renews Let's Encrypt certificates automatically for {$DOMAIN}.
#
# Routing: the API and uploaded images go straight to the backend, everything else (the built
# site) to the nginx frontend container. Caddy puts the *real* client address in X-Forwarded-For
# (replacing anything the client sent), which the API uses for rate limiting and analytics.

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Browsers will only use HTTPS for this domain for the next year.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}

# www -> apex. Needs a DNS record for www too (see docs/DEPLOY.md).
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
